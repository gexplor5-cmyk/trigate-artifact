+// 动机：辩论伤口——朴素计数 CAP 挡不住"间歇性建删循环攻击"（稳态活跃数 < CAP 但
+// 建删操作速率无界）。本补丁验证速率上界对该攻击类的增量防护。
+// 环境变量 FLEXRIC_RATE_CAP：每 xApp 每 1s 滑动窗口允许的 SUBSCRIBE+DELETE 操作数；
+// 未设置或 0 = off（baseline）。
+#define RATE_WIN_US   (1000000L)  // 1s 滑动窗口
+#define RATE_DEPTH    4096        // 每 slot 最多记录 4096 个时间戳
+#define RATE_SLOTS    1024        // xapp_id % RATE_SLOTS
+typedef struct {
+  int64_t ts[RATE_DEPTH];
+  int head;
+  long refused;   // 累计拒绝数（观测用）
+} rate_win_t;
+static rate_win_t g_rate[RATE_SLOTS];
+static pthread_mutex_t g_rate_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+static bool rate_gate_check_and_record(uint32_t xapp_id)
+{
+  static long rate_cap = -1;
+  if(rate_cap == -1){
+    const char* env = getenv("FLEXRIC_RATE_CAP");
+    rate_cap = (env != NULL) ? atol(env) : 0;
+    printf("[RATE] FLEXRIC_RATE_CAP=%ld ops/s (0=off)\n", rate_cap);
+  }
+  if(rate_cap <= 0)
+    return true;  // off
+
+  const int64_t now = time_now_us();
+  rate_win_t* w = &g_rate[xapp_id % RATE_SLOTS];
+  pthread_mutex_lock(&g_rate_mtx);
+  // 统计窗口内存活时间戳（顺带把窗口外的清零，实现滑动窗口）
+  int cnt = 0;
+  for(int i = 0; i < RATE_DEPTH; ++i){
+    if(w->ts[i] != 0){
+      if(now - w->ts[i] > RATE_WIN_US){
+        w->ts[i] = 0;            // 出窗，淘汰
+      } else {
+        cnt++;
+      }
+    }
+  }
+  if(cnt >= rate_cap){
+    w->refused++;
+    if((w->refused % 500) == 1)
+      printf("[RATE] xApp %u 窗口内 ops=%d >= CAP=%ld → REFUSE (累计 %ld)\n",
+             xapp_id, cnt, rate_cap, w->refused);
+    pthread_mutex_unlock(&g_rate_mtx);
+    return false;   // REFUSE：不转发 E2、不入表
+  }
+  // 记录本次操作
+  while(w->ts[w->head] != 0){ w->ts[w->head] = 0; w->head = (w->head + 1) % RATE_DEPTH; } // 找空位（窗口未满时必有）
+  w->ts[w->head] = now;
+  w->head = (w->head + 1) % RATE_DEPTH;
+  pthread_mutex_unlock(&g_rate_mtx);
+  return true;
+}
