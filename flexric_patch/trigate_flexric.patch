@@ -15,9 +15,180 @@
 #include "../../lib/async_event.h"
 #include "../../lib/ep/sctp_msg.h"
 #include "../../util/time_now_us.h"
+#include "../../util/alg_ds/ds/assoc_container/bimap.h"
 
 #include <stdio.h>
 #include <pthread.h>
+#include <stdlib.h>
+
+/* === [L1] R1-G 预解码语义准入（XDP 式"最早点处理"迁移，方案一）===
+ *
+ * 位置：E42 服务器事件循环，e2ap_msg_dec_iapp（完整 ASN.1 UPER 解码）之前。
+ * 原理：E42AP-PDU 的 UPER 头部前 2 字节即编码 PDU 选择支+procedureCode
+ *   （e42_templates.h 三模板实证：byte[1]=0x0e SetupRequest / 0x0f
+ *   SubscriptionRequest / 0x10 SubscriptionDeleteRequest），分类 O(1)。
+ * 强制：订阅/删除类操作按 per-association（sinfo_assoc_id）双令牌桶
+ *   (σ=FLEXRIC_L1_SIGMA, ρ=FLEXRIC_L1_RHO) + 并发存量 CAP（FLEXRIC_L1_CAP）
+ *   判定；违规静默丢弃——不解码、不转发 E2、不建 pending、不回包。
+ * 语义：贪心整形器（greedy shaper）——输出到达曲线由 (σ,ρ) 决定，
+ *   与攻击者 offered load 强度无关（网络演算定理 1 的部署形态）。
+ * 良性零误伤：SetupRequest 永不上闸；良性 xApp 为独立关联、操作数远小于 σ。
+ * 默认 FLEXRIC_L1 未设置时完全旁路（零行为变化）。 */
+typedef struct{
+  sctp_assoc_t assoc;
+  int64_t tokens_fp;   /* 固定点令牌 ×1000 */
+  int64_t last_us;
+  long subs_active;    /* 近似并发存量 = 放行订阅数 - 放行删除数（下限 0） */
+  long passed;
+  long dropped;
+} l1_state_t;
+
+#define L1_MAX_ASSOC 32
+static l1_state_t g_l1[L1_MAX_ASSOC];
+static long g_l1_rho = -1, g_l1_sigma = -1, g_l1_cap = -1;
+static long g_l1_total_dropped = 0;
+static long g_l1_fullpol = 0;    /* 0=pass 1=reject 2=lru */
+static void* NULL_FULL_REJECT = (void*)1; /* 满表拒绝哨兵（区别于 pass 的 NULL） */
+
+static
+l1_state_t* l1_slot(sctp_assoc_t assoc)
+{
+  for(int i = 0; i < L1_MAX_ASSOC; ++i)
+    if(g_l1[i].assoc == assoc) return &g_l1[i];
+  for(int i = 0; i < L1_MAX_ASSOC; ++i){
+    if(g_l1[i].assoc == 0){
+      g_l1[i].assoc = assoc;
+      g_l1[i].tokens_fp = g_l1_sigma * 1000;
+      g_l1[i].last_us = time_now_us();
+      g_l1[i].subs_active = 0;
+      return &g_l1[i];
+    }
+  }
+  /* [B11] 满表策略三臂：FLEXRIC_L1_FULLPOLICY={pass,reject,lru}
+   * pass=历史保守放行（B2-M1 绕过①：>32 关联全绕过）；reject=有界表 fail-closed
+   * （拒绝该消息——A·γ 聚合界的 A=表容量语义）；lru=驱逐最旧 slot 复用（活性近似）。
+   * 默认 pass 保持历史行为供对照。 */
+  {
+    static long fullpol = -1;
+    if(fullpol == -1){
+      const char* e = getenv("FLEXRIC_L1_FULLPOLICY");
+      fullpol = 0; /* pass */
+      if(e != NULL){
+        if(e[0] == 'r' || e[0] == '1') fullpol = 1;      /* reject */
+        else if(e[0] == 'l' || e[0] == '2') fullpol = 2; /* lru */
+      }
+    }
+    g_l1_fullpol = fullpol;
+    if(fullpol == 1) return NULL_FULL_REJECT;
+    if(fullpol == 2){
+      int victim = 0;
+      for(int i = 1; i < L1_MAX_ASSOC; ++i)
+        if(g_l1[i].last_us < g_l1[victim].last_us) victim = i;
+      g_l1[victim].assoc = assoc;
+      g_l1[victim].tokens_fp = g_l1_sigma * 1000;
+      g_l1[victim].last_us = time_now_us();
+      g_l1[victim].subs_active = 0;
+      return &g_l1[victim];
+    }
+  }
+  return NULL; /* 超出关联表容量：保守放行（不惩罚良性）——历史行为 */
+}
+
+/* 返回 true=放行（走完整解码路径），false=预解码丢弃 */
+static
+bool l1_prefilter(const sctp_msg_t* m)
+{
+  if(g_l1_rho == -1){
+    const char* e1 = getenv("FLEXRIC_L1");
+    const char* e2 = getenv("FLEXRIC_L1_RHO");
+    const char* e3 = getenv("FLEXRIC_L1_SIGMA");
+    const char* e4 = getenv("FLEXRIC_L1_CAP");
+    long on = (e1 != NULL) ? atol(e1) : 0;
+    g_l1_rho   = (on && e2 != NULL) ? atol(e2) : 100;
+    g_l1_sigma = (on && e3 != NULL) ? atol(e3) : 64;
+    g_l1_cap   = (on && e4 != NULL) ? atol(e4) : 64;
+    if(on)
+      printf("[L1] 预解码准入启用 rho=%ld/s sigma=%ld cap=%ld（贪心整形器语义）\n",
+             g_l1_rho, g_l1_sigma, g_l1_cap);
+    else
+      g_l1_rho = 0; /* off */
+  }
+  if(g_l1_rho == 0) return true; /* 未启用：旁路 */
+  if(m->type != SCTP_MSG_PAYLOAD || m->ba.len < 2) return true;
+
+  /* UPER 头分类：byte[0]=0x00（initiatingMessage 选择支，两 bit 对齐后），
+   * byte[1]=procedureCode。非三类订阅操作消息一律放行（保守）。 */
+  const uint8_t pc = m->ba.buf[1];
+  /* [B11] fail-closed：FLEXRIC_L1_FAILCLOSED=1 时未知 procedureCode（malformed
+   * 字节洪泛，B2-M1 绕过②/37229 实锤）默认拒绝；白名单=已知合法 E42AP 消息集。
+   * 默认 off=历史保守放行。 */
+  static long failclosed = -1;
+  if(failclosed == -1){
+    const char* e = getenv("FLEXRIC_L1_FAILCLOSED");
+    failclosed = (e != NULL && e[0] == '1') ? 1 : 0;
+  }
+  static const int pc_known[256] = {
+    [0x02]=1,[0x03]=1,[0x04]=1,[0x05]=1,[0x07]=1,[0x09]=1,[0x0a]=1,[0x0b]=1,
+    [0x0c]=1,[0x0d]=1,[0x0e]=1,[0x0f]=1,[0x10]=1,[0x11]=1,[0x12]=1,[0x1a]=1,[0x1b]=1,
+  };
+  if(failclosed && !pc_known[pc]){
+    long tot = __sync_fetch_and_add(&g_l1_total_dropped, 1) + 1;
+    if(tot % 2000 == 1)
+      printf("[L1] malformed procedureCode 0x%02x 预解码丢弃（fail-closed）累计=%ld\n",
+             pc, tot);
+    return false;
+  }
+  /* [R3B/缺陷#7 配套] 长度下限：FLEXRIC_L1_MINLEN>0 时短帧（截断变体：
+   * pc 白名单内但 body 不足）预解码丢弃——解码器守卫之前的更早防线。
+   * 合法 E42AP 帧数十字节，8-16 字节下限对良性零影响。默认 0=off。 */
+  {
+    static long minlen = -1;
+    if(minlen == -1){
+      const char* e = getenv("FLEXRIC_L1_MINLEN");
+      minlen = (e != NULL) ? atol(e) : 0;
+    }
+    if(minlen > 0 && (long)m->ba.len < minlen){
+      long tot = __sync_fetch_and_add(&g_l1_total_dropped, 1) + 1;
+      if(tot % 2000 == 1)
+        printf("[L1] 短帧 len=%zu < %ld 预解码丢弃（minlen，截断变体）累计=%ld\n",
+               m->ba.len, minlen, tot);
+      return false;
+    }
+  }
+  if(pc == 0x0f || pc == 0x10){
+    l1_state_t* s = l1_slot(m->info.sri.sinfo_assoc_id);
+    if(s == NULL_FULL_REJECT){
+      long tot = __sync_fetch_and_add(&g_l1_total_dropped, 1) + 1;
+      if(tot % 2000 == 1)
+        printf("[L1] 关联表满（%d slots）拒绝——有界表 fail-closed 累计=%ld\n",
+               L1_MAX_ASSOC, tot);
+      return false;
+    }
+    if(s == NULL) return true;
+    int64_t now = time_now_us();
+    int64_t dt = now - s->last_us;
+    if(dt > 0){ /* 补充令牌：tokens += rho * dt/1e6（固定点×1000） */
+      s->tokens_fp += g_l1_rho * dt / 1000;
+      if(s->tokens_fp > g_l1_sigma * 1000) s->tokens_fp = g_l1_sigma * 1000;
+      s->last_us = now;
+    }
+    bool ok = (s->tokens_fp >= 1000);
+    if(ok && pc == 0x0f && s->subs_active >= g_l1_cap) ok = false;
+    if(ok){
+      s->tokens_fp -= 1000;
+      if(pc == 0x0f) s->subs_active++; else if(s->subs_active > 0) s->subs_active--;
+      s->passed++;
+    } else {
+      s->dropped++;
+      long tot = __sync_fetch_and_add(&g_l1_total_dropped, 1) + 1;
+      if(tot % 2000 == 1)
+        printf("[L1] assoc %d 预解码丢弃（桶/cap 违规）累计=%ld\n",
+               (int)m->info.sri.sinfo_assoc_id, tot);
+      return false;
+    }
+  }
+  return true;
+}
 
