diff --git a/src/agent/msg_handler_agent.c b/src/agent/msg_handler_agent.c
index 159ed75..b5ac066 100644
--- a/src/agent/msg_handler_agent.c
+++ b/src/agent/msg_handler_agent.c
@@ -27,9 +27,171 @@
 #include "util/alg_ds/alg/alg.h"
 #include "util/alg_ds/ds/lock_guard/lock_guard.h"
 #include "util/compare.h"
+#include "util/time_now_us.h"
 
 #include <assert.h>
 #include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+/* === [E2-GATE]/[E2-RATE]/[E2-LEASE] R1-C：E2 节点侧协议对端强制（三上界下沉 E2）===
+ * 动机：smoke test实证——只删 RIC 侧表时 E2 agent 僵尸指示流 160 万条反灌（CPU 142%）。
+ * E2 侧强制=闸门下沉：即使 RIC 被绕过/攻陷/失联，E2 节点自身资源仍受保护。
+ * 环境变量（agent 进程）：
+ *   FLEXRIC_AGENT_SUB_CAP   全局（per-E2 节点）订阅存量上界（0=off）
+ *   FLEXRIC_AGENT_RATE_CAP  每 1s 订阅建立速率上界（0=off）
+ *   FLEXRIC_AGENT_GRACE_MS  RIC 失联后宽限期（租约回收，0=off；DHCP θ-cleanup 同构）
+ * REFUSE 语义（最小版）：不建立订阅、不响应（NONE）——与 RIC 侧 [GATE] REFUSE 同构。
+ * 标准化映射（E2AP 扩展 IE 的配额下发与 RIC_SUBSCRIPTION_FAILURE 响应）→ R2。 */
+
+static long e2_sub_cap(void)
+{
+  static long cap = -1;
+  if(cap == -1){
+    const char* env = getenv("FLEXRIC_AGENT_SUB_CAP");
+    cap = (env != NULL) ? atol(env) : 0;
+    printf("[E2-GATE] FLEXRIC_AGENT_SUB_CAP=%ld (0=off)\n", cap);
+  }
+  return cap;
+}
+
+static long e2_rate_cap(void)
+{
+  static long cap = -1;
+  if(cap == -1){
+    const char* env = getenv("FLEXRIC_AGENT_RATE_CAP");
+    cap = (env != NULL) ? atol(env) : 0;
+    printf("[E2-RATE] FLEXRIC_AGENT_RATE_CAP=%ld (0=off)\n", cap);
+  }
+  return cap;
+}
+
+static long e2_grace_ms(void)
+{
+  static long g = -1;
+  if(g == -1){
+    const char* env = getenv("FLEXRIC_AGENT_GRACE_MS");
+    g = (env != NULL) ? atol(env) : 0;
+    printf("[E2-LEASE] FLEXRIC_AGENT_GRACE_MS=%ld (0=off)\n", g);
+  }
+  return g;
+}
+
+/* 每秒计数速率窗（最小滑动窗=秒级桶，与 RIC 侧 [RATE] 同构简化） */
+static int64_t e2_rate_win_us = 0;
+static long e2_rate_cnt = 0;
+static long e2_rate_refused = 0;
+static long e2_cap_refused = 0;
+
+/* 失联时刻（us；0=连接正常）——由 e2_agent.c 事件循环维护 */
+int64_t g_e2_ric_lost_us = 0;
+
+/* === [WCET] R1-D：indication 处理与订阅建立的双口径耗时统计 === */
+static int64_t wcet_ind_max_us = 0;
+static int64_t wcet_ind_sum_us = 0;
+static long    wcet_ind_cnt = 0;
+static int64_t wcet_sub_max_us = 0;
+static int64_t wcet_sub_sum_us = 0;
+static long    wcet_sub_cnt = 0;
+static int64_t wcet_last_report_us = 0;
+
+void wcet_record_ind(int64_t us)
+{
+  if(us > wcet_ind_max_us) wcet_ind_max_us = us;
+  wcet_ind_sum_us += us;
+  wcet_ind_cnt++;
+  int64_t now = time_now_us();
+  if(now - wcet_last_report_us > 5000000LL){ // 每 5s 报告一次（增量+累计）
+    printf("[WCET] ind: n=%ld mean=%.1fus max=%lldus | sub_build: n=%ld mean=%.1fus max=%lldus\n",
+           wcet_ind_cnt, (double)wcet_ind_sum_us/wcet_ind_cnt, (long long)wcet_ind_max_us,
+           wcet_sub_cnt, wcet_sub_cnt ? (double)wcet_sub_sum_us/wcet_sub_cnt : 0.0,
+           (long long)wcet_sub_max_us);
+    fflush(stdout);
+    wcet_last_report_us = now;
+  }
+}
+
+void wcet_record_sub(int64_t us)
+{
+  if(us > wcet_sub_max_us) wcet_sub_max_us = us;
+  wcet_sub_sum_us += us;
+  wcet_sub_cnt++;
+}
+
+bool e2_enforce_gate(size_t ind_event_sz)
+{
+  // 失联宽限期内拒新订阅（租约语义：持有者死亡→不再接纳其新租约）
+  const long grace = e2_grace_ms();
+  if(grace > 0 && g_e2_ric_lost_us != 0){
+    e2_rate_refused++;
+    if(e2_rate_refused % 500 == 1)
+      printf("[E2-LEASE] RIC lost; REFUSE new subscription during grace (%ld)\n", e2_rate_refused);
+    return false;
+  }
+  // 存量上界
+  const long cap = e2_sub_cap();
+  if(cap > 0 && (long)ind_event_sz >= cap){
+    e2_cap_refused++;
+    if(e2_cap_refused % 500 == 1)
+      printf("[E2-GATE] ind_event %zu >= CAP %ld → REFUSE (累计 %ld)\n", ind_event_sz, cap, e2_cap_refused);
+    return false;
+  }
+  // 速率上界
+  const long rcap = e2_rate_cap();
+  if(rcap > 0){
+    int64_t now = time_now_us();
+    if(now - e2_rate_win_us > 1000000L){
+      e2_rate_win_us = now;
+      e2_rate_cnt = 0;
+    }
+    e2_rate_cnt++;
+    if(e2_rate_cnt > rcap){
+      e2_rate_refused++;
+      if(e2_rate_refused % 500 == 1)
+        printf("[E2-RATE] 1s 内 %ld > CAP %ld → REFUSE (累计 %ld)\n", e2_rate_cnt, rcap, e2_rate_refused);
+      return false;
+    }
+  }
+  return true;
+}
+
+/* 前向声明（stop_ind_event 定义在下方） */
+static bool stop_ind_event(e2_agent_t* ag, ric_gen_id_t id);
+
+/* [E2-LEASE] 租约回收：RIC 失联超过宽限期→回收全部 ind_event（僵尸指示流归零）。
+ * 返回回收条数。由 e2_agent.c 事件循环空转 tick 调用。 */
+size_t e2_lease_reclaim_ind_events(e2_agent_t* ag)
+{
+  const long grace = e2_grace_ms();
+  if(grace <= 0 || g_e2_ric_lost_us == 0) return 0;
+  int64_t now = time_now_us();
+  if(now - g_e2_ric_lost_us < (int64_t)grace * 1000L) return 0;
+
+  size_t reclaimed = 0;
+  while(true){
+    // 手动锁取一个 ric_id（stop_ind_event 内部也加锁，不可重入）
+    pthread_mutex_lock(&ag->mtx_ind_event);
+    void* start_r = assoc_rb_tree_front(&ag->ind_event.right);
+    void* end_r = assoc_rb_tree_end(&ag->ind_event.right);
+    ric_gen_id_t rid = {0};
+    bool has = false;
+    if(start_r != end_r){
+      ind_event_t* key = (ind_event_t*)assoc_rb_tree_key(&ag->ind_event.right, start_r);
+      rid = key->ric_id;
+      has = true;
+    }
+    pthread_mutex_unlock(&ag->mtx_ind_event);
+    if(!has) break;
+    if(stop_ind_event(ag, rid) != true) break; // 异常防死循环
+    reclaimed++;
+    if(reclaimed % 500 == 1)
+      printf("[E2-LEASE] reclaiming ind_events (%zu)...\n", reclaimed);
+  }
+  printf("[E2-LEASE] RIC 失联宽限 %ldms 到期 → 回收 %zu 条订阅（僵尸指示流归零）\n",
+         grace, reclaimed);
+  g_e2_ric_lost_us = 0; // 回收完成，回到初始态（等待 RIC 重连）
+  return reclaimed;
+}
 
